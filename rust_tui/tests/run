#!/usr/bin/env bash
set -uo pipefail
here="$(cd "$(dirname "$0")" && pwd)"

files=()
only=()
for arg in "$@"; do
  case "$arg" in
    test_*) only+=("$arg") ;;
  esac
done
args=()
for arg in "$@"; do
  case "$arg" in
    test_*) ;;
    *) args+=("$arg") ;;
  esac
done
set -- ${args[@]+"${args[@]}"}
case "${1:-}" in
  fast) shift ;;
  gates) set -- slow_gates ;;
  shellcheck)
    cd "$here/.." || exit 1
    exec shellcheck -x tui_repo tests/run tests/lib.sh tests/*_test.sh tests/fakes/*
    ;;
esac
if [ $# -eq 0 ]; then
  for file in "$here"/*_test.sh; do
    case "$(basename "$file")" in
      slow_*) ;;
      *) files+=("$file") ;;
    esac
  done
else
  for arg in "$@"; do
    files+=("$here/${arg%_test.sh}_test.sh")
  done
fi

expected="flow render runner slow_gates"
problems=""
for base in $expected; do
  [ -f "$here/${base}_test.sh" ] || problems="$problems${base}_test.sh is missing"$'\n'
done
for file in "$here"/*_test.sh; do
  [ -f "$file" ] || continue
  base="$(basename "$file" _test.sh)"
  case " $expected " in
    *" $base "*) ;;
    *) problems="$problems${base}_test.sh is not in the expected list ($expected)"$'\n' ;;
  esac
done
tools="$(bash -c 'source "$1"; harness_check' _ "$here/lib.sh")"
[ -z "$tools" ] || problems="$problems$tools"$'\n'

jobs_max="${TESTS_JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)}"
results="$(mktemp -d)"
trap 'rm -rf "$results"' EXIT
queue=()
for file in "${files[@]}"; do
  [ -f "$file" ] || continue
  if ! declared="$(bash -c 'set -e; source "$1"; declare -F' _ "$file" 2>"$results/source.err")"; then
    problems="$problems$(basename "$file") could not be sourced: $(tr '\n' ' ' <"$results/source.err")"$'\n'
    continue
  fi
  tests="$(printf '%s\n' "$declared" | awk '$3 ~ /^test_/ { print $3 }')"
  [ -n "$tests" ] || problems="$problems$(basename "$file") holds no test"$'\n'
  for name in $tests; do
    if [ ${#only[@]} -gt 0 ] && ! printf '%s\n' "${only[@]}" | grep -qx "$name"; then
      continue
    fi
    queue+=("$file $name")
  done
done

run_one() {
  local out="$results/$1"
  if bash -c 'set -euo pipefail; source "$1"; source "$2"; scratch_setup; trap scratch_teardown EXIT; "$3"' _ "$here/lib.sh" "$2" "$3" >"$out.log" 2>&1; then
    echo ok >"$out.status"
  else
    echo fail >"$out.status"
  fi
}

if [ -n "$problems" ]; then
  printf '%s' "$problems" | sed 's/^/tests\/run: /' >&2
  exit 1
fi

i=0
for entry in ${queue[@]+"${queue[@]}"}; do
  while [ "$(jobs -rp | wc -l)" -ge "$jobs_max" ]; do
    sleep 0.2
  done
  run_one "$i" "${entry%% *}" "${entry#* }" &
  i=$((i + 1))
done
wait

passed=0
failed=0
i=0
for entry in ${queue[@]+"${queue[@]}"}; do
  file="${entry%% *}"
  name="${entry#* }"
  output="$(cat "$results/$i.log")"
  if [ "$(cat "$results/$i.status")" = ok ]; then
    passed=$((passed + 1))
    printf 'ok   %s %s\n' "$(basename "$file" .sh)" "$name"
    printf '%s\n' "$output" | sed -n 's/^note: /     /p'
  else
    failed=$((failed + 1))
    printf 'FAIL %s %s\n%s\n' "$(basename "$file" .sh)" "$name" "$output" | sed '3,$s/^/     /'
  fi
  i=$((i + 1))
done
printf '%s passed, %s failed\n' "$passed" "$failed"
[ "$failed" -eq 0 ]
