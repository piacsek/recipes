#!/usr/bin/env bash
printf 'chrome %s\n' "$*" >>"${FAKE_LOG:-/dev/null}"
[ -z "${FAKE_CHROME_FAIL:-}" ] || exit 1
for arg in "$@"; do
  case "$arg" in
    --screenshot=*)
      if [ -n "${FAKE_CHROME_BROKEN:-}" ]; then
        printf 'PNG of the help\n' >"${arg#--screenshot=}"
      else
        printf '\211PNG\r\n\032\n\000\000\000\rIHDRhelp\n' >"${arg#--screenshot=}"
      fi
      ;;
  esac
done
