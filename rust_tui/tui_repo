#!/usr/bin/env bash
set -euo pipefail

if [ "${BASH_VERSINFO[0]}" -lt 3 ] || { [ "${BASH_VERSINFO[0]}" -eq 3 ] && [ "${BASH_VERSINFO[1]}" -lt 2 ]; }; then
  echo "tui_repo: needs bash 3.2 or newer, this is $BASH_VERSION" >&2
  exit 1
fi

recipe="$(cd "$(dirname "$0")" && pwd)"
templates="$recipe/templates"
keys="name snake upper class owner tap_repo tap description author year ruleset_id ruleset_fact date main_sha start pr_ref draft_pr"

usage() {
  cat <<'EOF'
usage: tui_repo [<name>] [--description <text>] [--owner <login>] [--tap <owner>/homebrew-<tap>]
                [--author <name>] [--yes] [--render-only <dir>]

Every value can also come from the environment: TUI_REPO_NAME, TUI_REPO_DESCRIPTION,
TUI_REPO_OWNER, TUI_REPO_TAP, TUI_REPO_AUTHOR, TUI_REPO_YES=1. What is missing is asked for.
EOF
}

die() {
  printf 'tui_repo: %s\n' "$1" >&2
  exit 1
}

name="${TUI_REPO_NAME:-}"
description="${TUI_REPO_DESCRIPTION:-}"
owner="${TUI_REPO_OWNER:-}"
tap_repo="${TUI_REPO_TAP:-}"
author="${TUI_REPO_AUTHOR:-}"
yes="${TUI_REPO_YES:-}"
render_only=""

while [ $# -gt 0 ]; do
  case "$1" in
    --description | --owner | --tap | --author | --render-only)
      [ $# -ge 2 ] || { usage >&2; exit 2; }
      case "$1" in
        --description) description="$2" ;;
        --owner) owner="$2" ;;
        --tap) tap_repo="$2" ;;
        --author) author="$2" ;;
        --render-only) render_only="$2" ;;
      esac
      shift 2
      ;;
    --yes) yes=1; shift ;;
    -h | --help) usage; exit 0 ;;
    -*) usage >&2; exit 2 ;;
    *) name="$1"; shift ;;
  esac
done

absolute() {
  case "$1" in
    "" | /*) printf '%s\n' "$1" ;;
    *) printf '%s/%s\n' "$PWD" "$1" ;;
  esac
}

HOME="$(absolute "$HOME")"
shared_denylist="$(absolute "${TUI_REPO_SHARED_DENYLIST:-$HOME/.config/conveyor-dev/denylist}")"
projects_dir="$(absolute "${PROJECTS_DIR:-$HOME/projects}")"
render_only="$(absolute "$render_only")"
[ -z "${TMPDIR:-}" ] || TMPDIR="$(absolute "$TMPDIR")"
[ -z "${CHROME:-}" ] || CHROME="$(absolute "$CHROME")"

ask() {
  local answer=""
  if [ ! -t 0 ] && [ -n "$3" ]; then
    printf -v "$1" '%s' "$3"
    return
  fi
  if [ -t 0 ]; then
    if [ -n "$3" ]; then
      printf '%s [%s]: ' "$2" "$3" >&2
    else
      printf '%s: ' "$2" >&2
    fi
  fi
  IFS= read -r answer || answer=""
  [ -n "$answer" ] || answer="$3"
  printf -v "$1" '%s' "$answer"
}

reserved_names="as async await break const continue crate dyn else enum extern false fn for gen if impl in let loop match mod move mut pub ref return self static struct super trait true type unsafe use where while abstract become box do final macro override priv typeof unsized virtual yield try union test std core alloc proc-macro build deps examples incremental con prn aux nul com1 com2 com3 com4 com5 com6 com7 com8 com9 lpt1 lpt2 lpt3 lpt4 lpt5 lpt6 lpt7 lpt8 lpt9"

name_problem() {
  local pattern='^[a-z][a-z0-9]*(-[a-z0-9]+)*$' word
  [ -n "$1" ] || { echo "no name given (pass it as the first argument or TUI_REPO_NAME)"; return; }
  [[ $1 =~ $pattern ]] || { echo "name \"$1\": use a lowercase letter first, then lowercase letters, digits and single hyphens, no hyphen at the end"; return; }
  [ "${#1}" -le 64 ] || { echo "name \"$1\": at most 64 characters"; return; }
  for word in $reserved_names; do
    [ "$1" != "$word" ] || { echo "name \"$1\": reserved (a Rust keyword, or a name cargo or Windows refuses)"; return; }
  done
  if { compgen -k; compgen -b; } | grep -qxF -- "$1"; then
    echo "name \"$1\": a bash keyword or builtin, so typing $1 in bash would run the shell's own word instead of the binary"
    return
  fi
  if sed -n 's/^name = "\(.*\)"$/\1/p' "$templates/Cargo.lock" | grep -vxF '{{name}}' | grep -qxF -- "$1"; then
    echo "name \"$1\": reserved, a package of that name is in the template's Cargo.lock, and two packages of one name break the release scripts"
  fi
}

description_problem() {
  local d="$1"
  [ -n "$d" ] || { echo "no description given (TUI_REPO_DESCRIPTION or --description)"; return; }
  case "$d" in *$'\n'* | *$'\r'*) echo "description: one line only"; return ;; esac
  if printf '%s' "$d" | LC_ALL=C grep -q '[^ -~]'; then
    echo "description: printable ASCII only (no accents, emoji, tabs or control characters)"
    return
  fi
  [ "${#d}" -le 80 ] || { echo "description: at most 80 characters (Homebrew's limit), this one has ${#d}"; return; }
  case "$d" in [A-Z]*) ;; *) echo "description: start with a capital letter (Homebrew's rule; it also keeps the README line from turning into a heading or a list)"; return ;; esac
  case "$d" in *.) echo "description: no full stop at the end (Homebrew's rule; the README adds one)"; return ;; esac
  case "$d" in *'?' | *!) echo "description: no ? or ! at the end (the README adds a full stop)"; return ;; esac
  case "$d" in *' ') echo "description: no space at the end"; return ;; esac
  case "$d" in *'<'* | *'>'*) echo "description: no < or >, Markdown and the PR body's HTML would read them as a tag"; return ;; esac
  case "$d" in *'"'*) echo "description: no double quote (\"), it ends the string in Cargo.toml, flake.nix, the formula and the Rust sources"; return ;; esac
  case "$d" in *\\*) echo "description: no backslash (\\), it starts an escape in TOML, Nix, Ruby, Rust and the formula's heredoc"; return ;; esac
  case "$d" in *'`'*) echo "description: no backtick (\`), it runs a command in the formula's heredoc"; return ;; esac
  case "$d" in *'$'*) echo "description: no dollar sign (\$), it expands in the formula's heredoc and \${ interpolates in Nix"; return ;; esac
  case "$d" in *'#{'* | *'#@'*) echo "description: no #{ or #@, Ruby interpolates them in the formula"; return ;; esac
}

owner_problem() {
  local pattern='^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$'
  [ -n "$1" ] || { echo "no GitHub owner given (TUI_REPO_OWNER or --owner)"; return; }
  if ! [[ $1 =~ $pattern ]] || [ "${#1}" -gt 39 ]; then
    echo "owner \"$1\": not a GitHub login (letters, digits and single hyphens, at most 39)"
  fi
}

tap_problem() {
  local pattern='^[A-Za-z0-9]+(-[A-Za-z0-9]+)*/homebrew-[A-Za-z0-9_-]+$'
  [ -n "$1" ] || { echo "no tap repository given (TUI_REPO_TAP or --tap)"; return; }
  [[ $1 =~ $pattern ]] || echo "tap \"$1\": must be <owner>/homebrew-<name>, the shape brew taps"
}

author_problem() {
  [ -n "$1" ] || { echo "no author given for LICENSE (TUI_REPO_AUTHOR or --author)"; return; }
  if printf '%s' "$1" | LC_ALL=C grep -q '[[:cntrl:]]' || [ "$(printf '%s\n' "$1" | wc -l | tr -d ' ')" != 1 ]; then
    echo "author: one line, no control characters"
  fi
}

[ -n "$name" ] || ask name "Name" ""
problem="$(name_problem "$name")"
[ -z "$problem" ] || die "$problem"
[ -n "$description" ] || ask description "One-line description" ""
if [ -z "$owner" ]; then
  detected=""
  [ -n "$render_only" ] || detected="$(gh api user --jq .login 2>/dev/null || true)"
  ask owner "GitHub owner" "$detected"
fi
[ -n "$tap_repo" ] || ask tap_repo "Tap repository" "${owner:+$owner/homebrew-tap}"
if [ -z "$author" ]; then
  detected=""
  [ -n "$render_only" ] || detected="$(git config user.name 2>/dev/null || true)"
  ask author "Author for LICENSE" "$detected"
fi

problems="$(description_problem "$description")"$'\n'"$(owner_problem "$owner")"$'\n'"$(tap_problem "$tap_repo")"$'\n'"$(author_problem "$author")"
problems="$(printf '%s\n' "$problems" | sed '/^$/d')"
[ -z "$problems" ] || { printf '%s\n' "$problems" | sed 's/^/tui_repo: /' >&2; exit 1; }

snake="${name//-/_}"
upper="$(printf '%s' "$snake" | tr '[:lower:]' '[:upper:]')"
class="$(printf '%s' "$name" | awk -F- '{ for (i = 1; i <= NF; i++) printf "%s%s", toupper(substr($i, 1, 1)), substr($i, 2) }')"
tap="${tap_repo%%/*}/${tap_repo#*/homebrew-}"
year="$(date -u +%Y)"
date="$(date -u +%Y-%m-%d)"
ruleset_id="${TUI_REPO_RULESET_ID:-unknown}"
ruleset_fact="The \`main\` ruleset (id $ruleset_id) exists and requires \`check\` and \`audit\`."
main_sha="${TUI_REPO_MAIN_SHA:-unknown}"
start="${TUI_REPO_START:-unknown}"
pr_ref=""
draft_pr=""

render() {
  local out="$1" only="${2:-}"
  export RT_name="$name" RT_snake="$snake" RT_upper="$upper" RT_class="$class" RT_owner="$owner" \
    RT_tap_repo="$tap_repo" RT_tap="$tap" RT_description="$description" RT_author="$author" \
    RT_year="$year" RT_ruleset_id="$ruleset_id" RT_ruleset_fact="$ruleset_fact" RT_date="$date" RT_main_sha="$main_sha" \
    RT_start="$start" RT_pr_ref="$pr_ref" RT_draft_pr="$draft_pr"
  RT_KEYS="$keys" RT_ONLY="$only" perl -e '
    use strict;
    use warnings;
    use File::Find;
    use File::Path qw(make_path);
    my ($src, $out) = @ARGV;
    my %v = map { $_ => $ENV{"RT_$_"} } split / /, $ENV{RT_KEYS};
    my $alternation = join "|", map { quotemeta } keys %v;
    my @files;
    find({ no_chdir => 1, wanted => sub { push @files, $File::Find::name if -f $_ } }, $src);
    for my $file (sort @files) {
      (my $rel = $file) =~ s{^\Q$src\E/}{};
      next if $ENV{RT_ONLY} ne "" && $rel ne $ENV{RT_ONLY};
      open my $in, "<:raw", $file or die "$file: $!";
      my $text = do { local $/; <$in> };
      close $in;
      $text =~ s/\{\{($alternation)\}\}/$v{$1}/g;
      if ($rel eq "Cargo.lock") {
        my $tail = $text =~ s/\n\z// ? "\n" : "";
        my @chunks = split /\n\n/, $text;
        my @head = grep { !/^\[\[package\]\]\n/ } @chunks;
        my $i = 0;
        my @packages = map { $_->[2] }
          sort { $a->[0] cmp $b->[0] or $a->[1] <=> $b->[1] }
          map { [ (/^name = "([^"]*)"/m)[0], $i++, $_ ] }
          grep { /^\[\[package\]\]\n/ } @chunks;
        $text = join("\n\n", @head, @packages) . $tail;
      }
      my $target = "$out/$rel";
      (my $dir = $target) =~ s{/[^/]*\z}{};
      make_path($dir);
      open my $fh, ">:raw", $target or die "$target: $!";
      print $fh $text;
      close $fh;
      chmod((stat $file)[2] & 0777, $target);
    }
  ' "$templates" "$out"
}

if [ -n "$render_only" ]; then
  if [ -e "$render_only" ] && [ -n "$(ls -A "$render_only")" ]; then
    die "$render_only is not empty"
  fi
  mkdir -p "$render_only"
  render "$render_only"
  if command -v cargo >/dev/null; then
    (cd "$render_only" && cargo fmt)
  else
    echo "tui_repo: cargo is missing, so the render is not formatted; run cargo fmt in $render_only" >&2
  fi
  echo "rendered $name into $render_only"
  exit 0
fi

repo="$owner/$name"
dir="$projects_dir/$name"
branch=phase-0-foundations
wt="$dir/.claude/worktrees/$branch"
remote_url="git@github.com:$repo.git"
work="$(mktemp -d "${TMPDIR:-/tmp}/tui_repo.XXXXXX")"
trap 'rm -rf "$work"' EXIT
link="$HOME/.config/$name-dev/denylist"
title="Set up $name with its checks, guidelines and automatic releases"
record_title="Record the phase 0 pull request in the metrics"
steps="denylist local repo push settings permissions ruleset labels worktree render screenshot ship body record"
wanted_settings="true,false,false,false,false,true,COMMIT_OR_PR_TITLE,COMMIT_MESSAGES,true,enabled,enabled"
wanted_labels="adversarial-review-finding|ededed|
development-cycle-improvement|0E8A16|Makes iterating on this project faster or more reliable
Type: Maintenance|BFD4F2|Upkeep with no new feature: tooling, refactors, internal quality"

origin=""

origin_of() {
  local status=0
  origin="$(git -C "$1" config --get remote.origin.url)" || status=$?
  case "$status" in
    0) ;;
    1) origin="" ;;
    *) die "could not find out the origin of $1" ;;
  esac
}

denylist_hits() {
  VALUE="$1" awk 'BEGIN { v = tolower(ENVIRON["VALUE"]) } { sub(/\r$/, "") } $0 != "" && index(v, tolower($0)) { n++ } END { print n + 0 }' "$2"
}

our_origin() {
  case "$origin" in
    "git@github.com:$repo.git" | "https://github.com/$repo" | "https://github.com/$repo.git") return 0 ;;
  esac
  return 1
}

is_clone() {
  local top
  top="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "$top" ] || return 1
  [ "$(cd "$top" && pwd -P)" = "$(cd "$dir" && pwd -P)" ] || return 1
  git -C "$dir" rev-parse -q --verify HEAD >/dev/null 2>&1 || return 1
  origin_of "$dir"
  our_origin
}

write_bootstrap() {
  local year="$bootstrap_year"
  mkdir -p "$1/.github/workflows"
  printf '# %s\n' "$name" >"$1/README.md"
  render "$1" LICENSE
  render "$1" CHANGELOG.md
  cat >"$1/.github/workflows/ci.yml" <<'EOF'
name: ci

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - run: echo "replace this step with the project's gates"
EOF
}

half_bootstrap() {
  local rel
  [ -d "$dir" ] && [ ! -L "$dir" ] || return 1
  if [ -e "$dir/.git" ] || [ -L "$dir/.git" ]; then
    [ -d "$dir/.git" ] && [ ! -L "$dir/.git" ] || return 1
    ! git -C "$dir" rev-parse -q --verify HEAD >/dev/null 2>&1 || return 1
    origin_of "$dir"
    [ -z "$origin" ] || our_origin || return 1
  fi
  rm -rf "$work/bootstrap"
  mkdir "$work/bootstrap"
  write_bootstrap "$work/bootstrap"
  (cd "$dir" && find . -path ./.git -prune -o -print) >"$work/present"
  while IFS= read -r rel; do
    rel="${rel#./}"
    case "$rel" in
      . | .git) continue ;;
      .github | .github/workflows)
        [ -d "$dir/$rel" ] && [ ! -L "$dir/$rel" ] || return 1
        continue
        ;;
    esac
    [ -f "$work/bootstrap/$rel" ] && [ -f "$dir/$rel" ] && [ ! -L "$dir/$rel" ] && cmp -s "$work/bootstrap/$rel" "$dir/$rel" || return 1
  done <"$work/present"
}

find_chrome() {
  if [ -n "${CHROME:-}" ]; then
    if [ -x "$CHROME" ]; then echo "$CHROME"; fi
    return 0
  fi
  if [ -x "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" ]; then
    echo "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
    return 0
  fi
  command -v google-chrome || command -v chromium || true
}

known_repo=""
known_pr=""
known_scaffold=""
known_branch=""
known_main=""
known_ruleset=""
known_enforcement=""
known_scope=""
known_ruleset_label=""
plan_note=""
known_empty=""
branch_names=""
main_foreign=""
probe_out=""
missing=""
missing_label_lines=""

forget() {
  known_repo=""
  known_pr=""
  known_scaffold=""
  known_branch=""
  known_main=""
  known_ruleset=""
  known_empty=""
}

lookup() {
  local what="$1"
  shift
  if probe_out="$("$@" 2>"$work/probe.err")"; then return 0; fi
  if grep -q '(HTTP 404)' "$work/probe.err"; then return 1; fi
  die "could not find out $what: $(tr '\n' ' ' <"$work/probe.err")"
}

query() {
  lookup "$@" || die "could not find out $1: not found"
}

repo_exists() {
  if [ -z "$known_repo" ]; then
    if lookup "whether $repo exists" gh api "repos/$repo" --jq .full_name; then known_repo=yes; else known_repo=no; fi
  fi
  [ "$known_repo" = yes ]
}

load_pr() {
  [ -z "$known_pr" ] || return 0
  known_pr=none
  repo_exists || return 0
  query "which pull request $branch has" gh pr list --repo "$repo" --head "$branch" --state all --json number,state,url,body,createdAt --jq '.[0] // empty'
  [ -z "$probe_out" ] || known_pr="$probe_out"
}

has_pr() {
  load_pr
  [ "$known_pr" != none ]
}

pr_field() {
  [ "$known_pr" = none ] || printf '%s\n' "$known_pr" | jq -r ".$1"
}

pr_open() {
  has_pr && [ "$(pr_field state)" = OPEN ]
}

scaffold_on_main() {
  if [ -z "$known_scaffold" ]; then
    known_scaffold=no
    if repo_exists && lookup "whether main holds scripts/ship.sh" gh api "repos/$repo/contents/scripts/ship.sh?ref=main" --jq .path; then
      known_scaffold=yes
    fi
  fi
  [ "$known_scaffold" = yes ]
}

remote_has() {
  lookup "whether $1 is on $repo" gh api "repos/$repo/branches/$1" --jq .name
}

remote_branch() {
  if [ -z "$known_branch" ]; then
    known_branch=no
    if repo_exists && remote_has "$branch"; then known_branch=yes; fi
  fi
  [ "$known_branch" = yes ]
}

remote_main() {
  if [ -z "$known_main" ]; then
    known_main=no
    if repo_exists && remote_has main; then known_main=yes; fi
  fi
  [ "$known_main" = yes ]
}

remote_empty() {
  if [ -z "$known_empty" ]; then
    known_empty=yes
    if repo_exists; then
      query "the branches of $repo" gh api --paginate "repos/$repo/branches" --jq '.[].name'
      branch_names="$probe_out"
      [ -z "$branch_names" ] || known_empty=no
    fi
  fi
  [ "$known_empty" = yes ]
}

joined() {
  awk 'NR > 1 { printf ", " } { printf "%s", $0 }'
}

license_on_main_ours() {
  query "the LICENSE on main of $repo" gh api "repos/$repo/contents/LICENSE?ref=main" --jq .content </dev/null
  printf '%s' "$probe_out" | perl -MMIME::Base64 -0777 -ne 'print decode_base64($_)' | sed 's/^Copyright (c) [0-9]\{4\} .*$/Copyright/' >"$work/license-main"
  sed 's/^Copyright (c) {{year}} {{author}}$/Copyright/' "$templates/LICENSE" | cmp -s - "$work/license-main"
}

foreign_on_main() {
  local sha rel n=0
  main_foreign=""
  rm -rf "$work/expected"
  mkdir "$work/expected"
  write_bootstrap "$work/expected"
  while read -r sha rel; do
    [ -n "$rel" ] || continue
    case "$rel" in
      LICENSE) if license_on_main_ours; then continue; fi ;;
      README.md | CHANGELOG.md | .github/workflows/ci.yml) [ "$sha" != "$(git hash-object "$work/expected/$rel")" ] || continue ;;
    esac
    n=$((n + 1))
    [ "$n" -gt 5 ] || main_foreign="${main_foreign:+$main_foreign, }$rel"
  done <"$work/main-tree"
  [ "$n" -le 5 ] || main_foreign="$main_foreign and $((n - 5)) more"
}

main_has() {
  awk -v want="$1" '{ sub(/^[^ ]* /, "") } $0 == want { found = 1 } END { exit !found }' "$work/main-tree"
}

check_ownership() {
  local rel
  repo_exists || return 0
  ! remote_empty || return 0
  query "the default branch of $repo" gh api "repos/$repo" --jq .default_branch
  [ "$probe_out" = main ] || die "$repo has $probe_out as its default branch, not main, so this recipe did not start it; pick another name"
  printf '%s\n' "$branch_names" | grep -qxF main || die "$repo has branches ($(printf '%s\n' "$branch_names" | joined)) but no main, so this recipe did not start it; pick another name"
  query "what main of $repo holds" gh api "repos/$repo/git/trees/main?recursive=1" --jq '.tree[] | select(.type == "blob") | "\(.sha) \(.path)"'
  printf '%s\n' "$probe_out" >"$work/main-tree"
  if main_has scripts/ship.sh && main_has plans/phase-0-foundations.md; then return 0; fi
  foreign_on_main
  [ -z "$main_foreign" ] || die "$repo already holds $main_foreign on main, which is neither this recipe's bootstrap nor its scaffold; pick another name"
  for rel in README.md LICENSE .github/workflows/ci.yml; do
    main_has "$rel" || die "$repo holds part of this recipe's bootstrap on main, without $rel; pick another name"
  done
  main_has CHANGELOG.md || remote_branch || has_pr ||
    die "main of $repo lacks the CHANGELOG.md the current bootstrap writes, and phase 0 is not on it yet; pick another name"
}

load_ruleset() {
  local id found="" enforcement="" scope="" rest
  [ -z "$known_ruleset" ] || return 0
  known_ruleset=none
  repo_exists || return 0
  query "the rulesets of $repo" gh api --paginate "repos/$repo/rulesets" --jq ".[] | select(.source_type == \"Repository\" and (.source | ascii_downcase) == \"$(printf '%s' "$repo" | tr '[:upper:]' '[:lower:]')\" and .target == \"branch\") | .id"
  for id in $probe_out; do
    query "ruleset $id of $repo" gh api "repos/$repo/rulesets/$id" --jq 'select(any(.conditions.ref_name.include[]?; IN("~DEFAULT_BRANCH", "~ALL", "refs/heads/main", "refs/heads/*", "refs/heads/**"))) | "\(.enforcement) \(if any(.conditions.ref_name.include[]?; IN("~ALL", "refs/heads/*", "refs/heads/**")) then "all" else "main" end) \(.id) \"\(.name)\""'
    [ -n "$probe_out" ] || continue
    enforcement="${probe_out%% *}"
    rest="${probe_out#* }"
    scope="${rest%% *}"
    found="$found${rest#* }"$'\n'
  done
  found="$(printf '%s' "$found" | sed '/^$/d')"
  [ -n "$found" ] || return 0
  [ "$(printf '%s\n' "$found" | wc -l | tr -d ' ')" = 1 ] ||
    die "more than one ruleset of $repo protects main: $(printf '%s\n' "$found" | awk 'NR > 1 { printf ", " } { printf "%s", $0 }'); keep one and rerun"
  known_ruleset="${found%% *}"
  known_ruleset_label="$found"
  known_enforcement="$enforcement"
  known_scope="$scope"
}

ruleset_all() {
  load_ruleset
  [ "$known_ruleset" != none ] && [ "$known_scope" = all ]
}

ruleset_inactive() {
  load_ruleset
  [ "$known_ruleset" != none ] && [ "$known_enforcement" != active ]
}

load_missing_checks() {
  local required="check audit"
  missing=""
  load_ruleset
  [ "$known_ruleset" != none ] || return 0
  if scaffold_on_main; then required="check audit version"; fi
  query "the required checks of the main ruleset" gh api "repos/$repo/rulesets/$known_ruleset" --jq "([\"${required// /\",\"}\"] - [.rules[] | select(.type == \"required_status_checks\") | .parameters.required_status_checks[].context]) | join(\", \")"
  missing="$probe_out"
}

local_branch() {
  [ -d "$dir" ] && git -C "$dir" rev-parse -q --verify "refs/heads/$branch" >/dev/null 2>&1
}

ahead() {
  if local_branch && git -C "$dir" rev-parse -q --verify refs/remotes/origin/main >/dev/null 2>&1; then
    git -C "$dir" rev-list --count "origin/main..refs/heads/$branch"
  else
    echo 0
  fi
}

ours() {
  local n
  [ -d "$wt" ] || return 1
  n="$(ahead)"
  [ "$n" = 0 ] && return 0
  [ "$n" = 1 ] && [ "$(git -C "$dir" log -1 --format=%s "refs/heads/$branch")" = "$title" ]
}

phase0_active() {
  repo_exists || return 0
  ! has_pr || return 1
  if scaffold_on_main; then return 1; fi
  if local_branch; then
    ours
    return
  fi
  if remote_branch; then return 1; fi
  return 0
}

load_missing_labels() {
  local have="" line label
  missing_label_lines=""
  if repo_exists; then
    query "the labels of $repo" gh label list --repo "$repo" --json name --limit 500 --jq '.[].name'
    have="$probe_out"
  fi
  while IFS= read -r line; do
    label="${line%%|*}"
    printf '%s\n' "$have" | grep -qixF -- "$label" || missing_label_lines="$missing_label_lines$line"$'\n'
  done <<EOF
$wanted_labels
EOF
}

plan_denylist() {
  plan=""
  [ -e "$link" ] || [ -L "$link" ] || plan="link $link to $shared_denylist"
}

do_denylist() {
  mkdir -p "$(dirname "$link")"
  ln -s "$shared_denylist" "$link"
}

plan_local() {
  plan=""
  if [ -d "$dir" ] && git -C "$dir" rev-parse -q --verify HEAD >/dev/null 2>&1; then return 0; fi
  if [ ! -e "$dir" ] && remote_main; then
    plan="clone $repo into $dir"
  else
    plan="create $dir with a bootstrap commit (README.md, LICENSE, CHANGELOG.md, a ci.yml whose check job echoes)"
  fi
}

do_local() {
  if [ ! -e "$dir" ] && remote_main; then
    git clone -q "$remote_url" "$dir"
    return
  fi
  mkdir -p "$dir/.github/workflows"
  [ -d "$dir/.git" ] || git -C "$dir" init -q --initial-branch main
  origin_of "$dir"
  [ -n "$origin" ] || git -C "$dir" remote add origin "$remote_url"
  write_bootstrap "$dir"
  git -C "$dir" add -A
  git -C "$dir" commit -q -m "Bootstrap"
}

plan_repo() {
  plan=""
  repo_exists || plan="create the public repository $repo"
}

do_repo() {
  gh repo create "$repo" --public --description "$description" >/dev/null
}

plan_push() {
  plan=""
  if repo_exists && ! remote_empty; then return 0; fi
  plan="push main to $repo"
}

do_push() {
  git -C "$dir" push -q -u origin main
}

plan_settings() {
  plan=""
  if repo_exists && query "the repository settings" gh api "repos/$repo" --jq '[.allow_squash_merge, .allow_merge_commit, .allow_rebase_merge, .allow_auto_merge, .allow_update_branch, .delete_branch_on_merge, .squash_merge_commit_title, .squash_merge_commit_message, .has_discussions, .security_and_analysis.secret_scanning.status, .security_and_analysis.secret_scanning_push_protection.status] | map(tostring) | join(",")' && [ "$probe_out" = "$wanted_settings" ]; then
    return 0
  fi
  plan="squash merges only, delete merged branches, discussions on, secret scanning and push protection on"
}

do_settings() {
  gh api --silent -X PATCH "repos/$repo" --input - <<'EOF'
{
  "allow_squash_merge": true,
  "allow_merge_commit": false,
  "allow_rebase_merge": false,
  "allow_auto_merge": false,
  "allow_update_branch": false,
  "delete_branch_on_merge": true,
  "squash_merge_commit_title": "COMMIT_OR_PR_TITLE",
  "squash_merge_commit_message": "COMMIT_MESSAGES",
  "has_discussions": true,
  "security_and_analysis": {
    "secret_scanning": { "status": "enabled" },
    "secret_scanning_push_protection": { "status": "enabled" }
  }
}
EOF
}

plan_permissions() {
  plan=""
  if repo_exists && query "the Actions token permissions" gh api "repos/$repo/actions/permissions/workflow" --jq '"\(.default_workflow_permissions),\(.can_approve_pull_request_reviews)"' && [ "$probe_out" = "read,false" ]; then
    return 0
  fi
  plan="the Actions token reads only and approves no pull request"
}

do_permissions() {
  gh api --silent -X PUT "repos/$repo/actions/permissions/workflow" \
    -f default_workflow_permissions=read \
    -F can_approve_pull_request_reviews=false
}

plan_ruleset() {
  plan=""
  load_ruleset
  if [ "$known_ruleset" = none ]; then
    plan="create the main ruleset, requiring check and audit"
    return 0
  fi
  if ruleset_all; then
    plan_note="ruleset $known_ruleset_label covers every branch, so requiring checks would refuse the first push of $branch; left as is"
    return 0
  fi
  load_missing_checks
  [ -z "$missing" ] || plan="add $missing to the required checks"
  if ruleset_inactive; then
    plan_note="ruleset $known_ruleset_label is $known_enforcement, not active; left as is"
  fi
}

do_ruleset() {
  local id
  load_ruleset
  if [ "$known_ruleset" = none ]; then
    gh api --silent -X POST "repos/$repo/rulesets" --input - <<'EOF'
{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": { "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] } },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" },
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": ["squash"],
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": false
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": false,
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          { "context": "check", "integration_id": 15368 },
          { "context": "audit", "integration_id": 15368 }
        ]
      }
    }
  ]
}
EOF
    known_ruleset=""
  fi
  load_missing_checks
  id="$known_ruleset"
  [ -n "$missing" ] || return 0
  gh api "repos/$repo/rulesets/$id" | jq --arg add "$missing" '
    ($add | split(", ") | map({context: ., integration_id: 15368})) as $new
    | {name, target, enforcement, bypass_actors, conditions,
       rules: (if any(.rules[]; .type == "required_status_checks")
         then .rules | map(if .type == "required_status_checks" then .parameters.required_status_checks += $new else . end)
         else .rules + [{type: "required_status_checks", parameters: {do_not_enforce_on_create: false, strict_required_status_checks_policy: true, required_status_checks: $new}}]
         end)}' | gh api --silent -X PUT "repos/$repo/rulesets/$id" --input -
  echo "main ruleset: added $missing to the required checks"
}

plan_labels() {
  local names
  plan=""
  load_missing_labels
  names="$(printf '%s' "$missing_label_lines" | cut -d'|' -f1 | awk 'NR > 1 { printf ", " } { printf "%s", $0 }')"
  [ -z "$names" ] || plan="create $names"
}

do_labels() {
  local label color text
  load_missing_labels
  while IFS='|' read -r label color text; do
    [ -n "$label" ] || continue
    gh label create "$label" --repo "$repo" --color "$color" --description "$text" >/dev/null
  done <<EOF
$missing_label_lines
EOF
}

plan_worktree() {
  plan=""
  phase0_active || return 0
  [ -d "$wt" ] || plan="add the $branch worktree off origin/main at $wt"
}

do_worktree() {
  git -C "$dir" fetch -q origin
  git -C "$dir" worktree add -q --no-track -b "$branch" "$wt" origin/main
}

render_missing=""
render_foreign=""

fresh_render() {
  local files
  files="$(git -C "$wt" ls-tree -r --name-only origin/main | LC_ALL=C sort | tr '\n' ' ')"
  case "$files" in
    ".github/workflows/ci.yml CHANGELOG.md LICENSE README.md ") ;;
    *) die "main holds more than the bootstrap commit ($files), so the phase 0 plan's facts would be false" ;;
  esac
  load_ruleset
  ruleset_id="$known_ruleset"
  if [ "$known_scope" = all ]; then
    ruleset_fact="The ruleset that protects \`main\` (id $ruleset_id) covers every branch, so \`tui_repo\` left it as it is and added no required checks."
  elif [ "$known_enforcement" != active ]; then
    ruleset_fact="The \`main\` ruleset (id $ruleset_id) lists \`check\` and \`audit\` as required, but its enforcement is \`$known_enforcement\`, so it enforces nothing yet."
  else
    ruleset_fact="The \`main\` ruleset (id $ruleset_id) exists and requires \`check\` and \`audit\`."
  fi
  main_sha="$(git -C "$wt" rev-parse --short origin/main)"
  git -C "$dir" reflog show --format=%ct "refs/heads/$branch" >"$work/reflog"
  start="$(tail -n 1 "$work/reflog")"
  [ -n "$start" ] || start="$(git -C "$dir" log --max-parents=0 -1 --format=%ct "refs/heads/$branch")"
  [ -n "$start" ] || start="$(date -u +%s)"
  start="$(perl -MPOSIX -e 'print strftime("%Y-%m-%d %H:%M:%SZ", gmtime($ARGV[0]))' "$start")"
  date="${start%% *}"
  year="${start%%-*}"
  rm -rf "$work/render"
  mkdir "$work/render"
  render "$work/render"
  cargo fmt --manifest-path "$work/render/Cargo.toml"
}

compare_render() {
  local entry rel
  render_missing=""
  render_foreign=""
  (cd "$work/render" && find . -type f | sed 's|^\./||' | LC_ALL=C sort) >"$work/rendered"
  git -C "$wt" status --porcelain -z --untracked-files=all >"$work/status"
  while IFS= read -r -d '' entry; do
    rel="${entry:3}"
    [ "$rel" != docs/help.png ] || continue
    case "$rel" in *.tui_repo-partial) [ ! -f "$work/render/${rel%.tui_repo-partial}" ] || continue ;; esac
    if [ -f "$work/render/$rel" ] && [ -f "$wt/$rel" ] && cmp -s "$work/render/$rel" "$wt/$rel"; then
      continue
    fi
    render_foreign="$render_foreign $rel"
  done <"$work/status"
  while IFS= read -r rel; do
    if cmp -s "$work/render/$rel" "$wt/$rel" 2>/dev/null; then continue; fi
    render_missing="$render_missing$rel"$'\n'
    { [ -e "$wt/$rel" ] || [ -L "$wt/$rel" ]; } || continue
    git -C "$wt" cat-file -e "HEAD:$rel" 2>/dev/null && continue
    case "$render_foreign " in *" $rel "*) ;; *) render_foreign="$render_foreign $rel" ;; esac
  done <"$work/rendered"
}

worktree_on_branch() {
  local head
  head="$(git -C "$wt" symbolic-ref -q --short HEAD || true)"
  [ "$head" = "$branch" ] || die "the phase 0 worktree $wt has ${head:-a detached HEAD} checked out, not $branch; check out $branch there and rerun"
}

plan_render() {
  plan=""
  phase0_active || return 0
  [ ! -d "$wt" ] || worktree_on_branch
  [ "$(ahead)" = 0 ] || return 0
  if [ -d "$wt" ]; then
    fresh_render
    compare_render
    [ -z "$render_foreign" ] || die "the phase 0 worktree holds changes the render would not write:$render_foreign; move them away and rerun"
    [ -n "$render_missing" ] || return 0
  fi
  plan="render the rust_tui template into the worktree"
}

do_render() {
  local rel
  while IFS= read -r rel; do
    rm -f "$wt/$rel.tui_repo-partial"
  done <"$work/rendered"
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    mkdir -p "$(dirname "$wt/$rel")"
    cp -p "$work/render/$rel" "$wt/$rel.tui_repo-partial"
    mv -f "$wt/$rel.tui_repo-partial" "$wt/$rel"
  done <<EOF
$render_missing
EOF
}

help_png_ok() {
  [ -f "$1" ] && [ -s "$1" ] && [ "$(od -An -tx1 -N8 "$1" | tr -d ' \n')" = 89504e470d0a1a0a ]
}

plan_screenshot() {
  plan=""
  phase0_active || return 0
  [ "$(ahead)" = 0 ] || return 0
  help_png_ok "$wt/docs/help.png" || plan="run scripts/screenshots.sh for docs/help.png"
}

do_screenshot() {
  cd "$wt"
  CHROME="$(find_chrome)" scripts/screenshots.sh docs
  help_png_ok docs/help.png || die "scripts/screenshots.sh wrote no PNG to docs/help.png"
}

ship_guard() {
  local changes
  worktree_on_branch
  [ "$(ahead)" = 1 ] || return 0
  changes="$(git -C "$wt" status --porcelain --untracked-files=all | cut -c4- | tr '\n' ' ')"
  [ -z "$changes" ] || die "the phase 0 worktree holds changes besides the phase 0 commit: ${changes% }; move them away and rerun"
}

plan_ship() {
  plan=""
  phase0_active || return 0
  [ ! -d "$wt" ] || ship_guard
  plan="ship the branch and open the draft pull request \"$title\""
}

do_ship() {
  ship_guard
  cd "$wt"
  if [ "$(ahead)" = 1 ] && [ -z "$(git rev-list HEAD --not --remotes)" ]; then
    gh pr create --draft --assignee @me --title "$title" --body-file .github/pull_request_template.md >/dev/null
  else
    scripts/ship.sh "$title"
  fi
}

template_body() {
  tr -d '\r' <"$templates/.github/pull_request_template.md"
}

plan_body() {
  plan=""
  if phase0_active || { pr_open && [ "$(pr_field body | tr -d '\r')" = "$(template_body)" ]; }; then
    plan="write the summary, the changes, the help screenshot and the release diagram"
  fi
}

pr_body() {
  cat <<EOF
## Summary

Sets up $name with the gates, workflows, guidelines and plans of the \`rust_tui\` recipe, rendered and shipped by its \`tui_repo\` script.
Merging it releases v0.0.1 to \`$tap_repo\` and points the \`stable\` branch at it.

## Changes

- The binary answers \`--help\`, \`-h\`, \`help\`, \`--version\`, \`-V\`, \`version\` and \`changelog\`, and nothing else yet; Phase 1 defines what $name is.
- Gates, the scrub check, ship, CI, the release and \`version\` workflows, the agent guidelines and the plans come from the recipe, renamed for $name.
- Owner steps: before merging, set the \`TAP_TOKEN\` secret as the \`tui_repo\` run printed; after merging, rerun \`tui_repo $name\`, which adds \`version\` to the required checks.

![$name --help](https://raw.githubusercontent.com/$repo/$1/docs/help.png)

\`\`\`mermaid
flowchart TD
  pr["Pull request with a fragment"] -->|"the required checks pass"| merge["Squash merge to main"]
  merge --> tag["tag"]
  tag -->|"no fragment pending"| idle["Nothing released"]
  tag -->|"vX.Y.Z tag on a release commit"| build["build"]
  build -->|"three tarballs"| publish["publish"]
  publish --> release["GitHub release"]
  publish --> tap["tap"]
  idle -->|"runs anyway"| tap
  tap -->|"only when behind the newest release"| formula["Formula in $tap_repo"]
  publish --> stablebuild["stable-build"]
  idle -->|"runs anyway"| stablebuild
  stablebuild -->|"only when behind the newest release"| stable["stable"]
  stable --> moved["stable branch at vX.Y.Z"]
\`\`\`
EOF
}

do_body() {
  local sha
  load_pr
  git -C "$dir" fetch -q origin
  sha="$(git -C "$dir" log -1 --format=%H "origin/$branch" -- docs/help.png)"
  [ -n "$sha" ] || die "origin/$branch has no docs/help.png"
  pr_body "$sha" | gh pr edit "$(pr_field number)" --repo "$repo" --body-file - >/dev/null
}

record_metrics() {
  local at cell metrics_start
  at="$(pr_field createdAt)"
  metrics_start="$(sed -n 's/^| 0 |  | \([^|]*\) |  | .*/\1/p' "$1")"
  cell="${at#*T}"
  [ "${metrics_start%% *}" = "${at%%T*}" ] || cell="${at%%T*} $cell"
  RT_PR="#$(pr_field number)" RT_CELL="$cell" perl -i -pe 's/^\| 0 \|  \| ([^|]*) \|  \|/| 0 | $ENV{RT_PR} | $1 | $ENV{RT_CELL} |/' "$1"
}

record_guard() {
  local entry rel foreign="" commits
  worktree_on_branch
  load_pr
  git -C "$wt" show HEAD:plans/metrics.md >"$work/metrics.md"
  record_metrics "$work/metrics.md"
  git -C "$wt" status --porcelain -z --untracked-files=all >"$work/status"
  while IFS= read -r -d '' entry; do
    rel="${entry:3}"
    if [ "$rel" = plans/metrics.md ] && cmp -s "$work/metrics.md" "$wt/plans/metrics.md"; then continue; fi
    foreign="$foreign $rel"
  done <"$work/status"
  [ -z "$foreign" ] || die "the phase 0 worktree holds changes besides the metrics record:$foreign; move them away and rerun"
  commits="$(git -C "$wt" log --format=%s HEAD --not --remotes | grep -vxF -- "$record_title" | joined || true)"
  [ -z "$commits" ] || die "the phase 0 worktree holds unpushed commits besides the metrics record ($commits); move them away and rerun"
}

plan_record() {
  plan=""
  if phase0_active; then
    plan="write the pull request's number and opening time into plans/metrics.md and ship it"
  elif pr_open && [ -d "$wt" ] && git -C "$wt" show "origin/$branch:plans/metrics.md" 2>/dev/null | grep -q '^| 0 |  |'; then
    record_guard
    plan="write the pull request's number and opening time into plans/metrics.md and ship it"
  fi
}

do_record() {
  record_guard
  cd "$wt"
  record_metrics plans/metrics.md
  scripts/ship.sh "$record_title"
}

label_of() {
  case "$1" in
    denylist) echo "denylist link" ;;
    local) echo "local repository" ;;
    repo) echo "GitHub repository" ;;
    push) echo "push main" ;;
    settings) echo "repository settings" ;;
    permissions) echo "Actions token permissions" ;;
    ruleset) echo "main ruleset" ;;
    labels) echo "labels" ;;
    worktree) echo "phase 0 worktree" ;;
    render) echo "phase 0 render" ;;
    screenshot) echo "help screenshot" ;;
    ship) echo "phase 0 pull request" ;;
    body) echo "pull request body" ;;
    record) echo "pull request in the metrics" ;;
  esac
}

missing_tools() {
  local tool
  for tool in gh git jq perl; do
    command -v "$tool" >/dev/null || echo "$tool is missing: brew install $tool"
  done
  [ -n "$active" ] || return 0
  command -v tmux >/dev/null || echo "tmux is missing: brew install tmux"
  command -v freeze >/dev/null || echo "freeze is missing: brew install charmbracelet/tap/freeze"
  [ -n "$(find_chrome)" ] || echo "Google Chrome or chromium is missing: install Google Chrome, or set CHROME to a Chrome or chromium binary"
  command -v python3 >/dev/null || echo "python3 is missing: brew install python"
  command -v cargo >/dev/null || echo "cargo is missing: install Rust with rustup (https://rustup.rs)"
}

bootstrap_year="$year"
if [ -f "$dir/LICENSE" ] && [ ! -L "$dir/LICENSE" ]; then
  license_year="$(sed -n 's/^Copyright (c) \([0-9]\{4\}\) .*/\1/p' "$dir/LICENSE" | head -n 1)"
  [ -z "$license_year" ] || bootstrap_year="$license_year"
fi
if { [ -e "$dir" ] || [ -L "$dir" ]; } && ! is_clone && ! half_bootstrap; then
  die "$dir exists and is not a clone of $repo; move it away or pick another name"
fi
if [ ! -e "$link" ] && [ ! -L "$link" ]; then
  [ -e "$shared_denylist" ] || die "the shared denylist $shared_denylist is missing, so $link cannot link to it; create it or set TUI_REPO_SHARED_DENYLIST"
  { [ -f "$shared_denylist" ] && [ -r "$shared_denylist" ] && [ -s "$shared_denylist" ]; } ||
    die "the shared denylist $shared_denylist is not a readable, non-empty file, so $link cannot link to it; fix it or set TUI_REPO_SHARED_DENYLIST"
fi
denylist="$shared_denylist"
if [ -e "$link" ] || [ -L "$link" ]; then
  { [ -f "$link" ] && [ -r "$link" ] && [ -s "$link" ]; } || die "$link is not a readable, non-empty file; fix or remove it"
  echo "denylist: $link is a readable, non-empty file"
  denylist="$link"
fi
[ -r "$denylist" ] || die "$denylist cannot be read"
hits=""
for input in name description owner tap_repo author; do
  if [ "$(denylist_hits "${!input}" "$denylist")" != 0 ]; then
    case "$input" in tap_repo) input=tap ;; esac
    hits="$hits$input "
  fi
done
for input in $hits; do
  echo "tui_repo: the $input matches the denylist; pick another" >&2
done
[ -z "$hits" ] || exit 1
command -v gh >/dev/null || die "gh is missing: brew install gh"
check_ownership
lookup "whether $tap_repo exists" gh api "repos/$tap_repo" --jq .full_name ||
  die "the tap repository $tap_repo does not exist, or gh cannot see it; create it or pass another --tap"
active=""
if phase0_active; then active=1; fi
tools="$(missing_tools)"
[ -z "$tools" ] || { printf '%s\n' "$tools" | sed 's/^/tui_repo: /' >&2; exit 1; }

echo "tui_repo: $repo in $dir"
printf '  name: %s\n  description: %s\n  owner: %s\n  tap: %s\n  author: %s\n' "$name" "$description" "$owner" "$tap_repo" "$author"
pending=""
planned=" "
for s in $steps; do
  plan_note=""
  "plan_$s"
  if [ -n "$plan" ]; then
    printf '  %s: %s%s\n' "$(label_of "$s")" "$plan" "${plan_note:+ ($plan_note)}"
    pending=1
    planned="$planned$s "
  else
    printf '  %s: already done%s\n' "$(label_of "$s")" "${plan_note:+ ($plan_note)}"
  fi
done

if [ -n "$pending" ] && [ -z "$yes" ]; then
  answer=""
  [ ! -t 0 ] || printf 'Go ahead? [y/N]: ' >&2
  IFS= read -r answer || answer=""
  case "$answer" in y | Y | yes) ;; *) die "declined, nothing changed" ;; esac
fi

current=""
set -E
trap 'printf "tui_repo: stopped at \"%s\"; rerun tui_repo %s to finish from there\n" "$current" "$name" >&2' ERR
for s in $steps; do
  current="$(label_of "$s")"
  "plan_$s"
  if [ -z "$plan" ]; then
    case "$planned" in *" $s "*) die "the plan said $current would run, but it was already done when its turn came; something changed it meanwhile, so read the state and rerun tui_repo $name" ;; esac
    echo "==> $current: already done, skipped"
    continue
  fi
  echo "==> $current: $plan"
  "do_$s"
  forget
done
trap - ERR
set +E
cd "$dir"

load_pr
url="$(pr_field url)"
[ -z "$url" ] || echo "$url"
if [ -z "$url" ] && local_branch && ! ours; then
  if [ "$(ahead)" = 0 ]; then
    echo "tui_repo: $branch exists locally with no commit of its own but is not checked out at $wt, so phase 0 was left alone"
  else
    echo "tui_repo: $branch exists locally with other work and no pull request, so phase 0 was left alone"
  fi
fi
if [ -z "$url" ] && ! local_branch && remote_branch; then
  cat <<EOF
tui_repo: $branch is on $repo with no pull request and no local branch, so phase 0 was left alone; to open the pull request, run:
   git -C $dir fetch origin
   git -C $dir show origin/$branch:.github/pull_request_template.md | gh pr create --repo $repo --head $branch --draft --assignee @me --title "$title" --body-file -
EOF
fi
if ! scaffold_on_main; then
  echo "After merging the pull request, rerun tui_repo $name to require the remaining checks."
fi
if ruleset_all; then
  echo "tui_repo: the main ruleset $known_ruleset_label covers every branch, so requiring check and audit would refuse the first push of $branch; it was left as is"
fi
if ruleset_inactive; then
  echo "tui_repo: the main ruleset $known_ruleset_label is $known_enforcement, not active, so it enforces nothing; it was left as is"
fi
query "whether TAP_TOKEN is set" gh secret list --repo "$repo" --json name --jq '.[].name'
if printf '%s\n' "$probe_out" | grep -qx TAP_TOKEN; then
  echo "TAP_TOKEN: already set"
else
  tap_owner="${tap_repo%%/*}"
  token_url="https://github.com/settings/personal-access-tokens/new?name=$name-tap&contents=write"
  query "who is logged in to gh" gh api user --jq .login
  if [ "$(printf '%s' "$probe_out" | tr '[:upper:]' '[:lower:]')" != "$(printf '%s' "$tap_owner" | tr '[:upper:]' '[:lower:]')" ]; then
    token_url="$token_url&target_name=$tap_owner"
  fi
  cat <<EOF
Before merging the pull request, set TAP_TOKEN (the release needs it to write the Homebrew formula):

1. Create the token: $token_url
   Repository access: Only select repositories → ${tap_repo#*/}. Permission: Contents → Read and write.
2. Copy the token, then run:
   pbpaste | gh secret set TAP_TOKEN --repo $repo
EOF
fi
